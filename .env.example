# Copy to .env to override. docker-compose.yml falls back to these defaults when unset.
POSTGRES_DB=birthdays
POSTGRES_USER=birthday
POSTGRES_PASSWORD=birthday

RABBITMQ_USER=birthday
RABBITMQ_PASSWORD=birthday

SUBMISSIONS_QUEUE=birthday.submissions
REMINDERS_QUEUE=birthday.reminders
# Daily reminder run, Spring cron format (sec min hour day month weekday), UTC.
REMINDER_CRON=0 0 6 * * *

API_PORT=3000
COORDINATOR_PORT=8082
FRONTEND_PORT=8081
