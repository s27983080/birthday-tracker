{
  "name": "birthday-tracker-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API: validates birthday submissions, publishes them to RabbitMQ, and serves birthdays from PostgreSQL.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
